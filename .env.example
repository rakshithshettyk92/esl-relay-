# -------------------------------------------------------
# Copy this file to .env and fill in the values.
# NEVER commit .env to git.
# -------------------------------------------------------

# --- Firebase (from Firebase Console > Project Settings > Service Accounts) ---
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# --- Auth header that AIMS will send ---
# Set AUTH_HEADER_NAME to whatever header name you configure in AIMS
# e.g.  x-auth-key  or  authorization  or  x-api-key
AUTH_HEADER_NAME=x-auth-key
AUTH_KEY=change-me-to-a-strong-secret

# --- FCM topic (default: employee-calls) ---
FCM_TOPIC=employee-calls

# --- AIMS ESL API ---
ESL_BASE_URL=https://eastus.common.solumesl.com/common
# Optional but strongly recommended in production. When supplied, the relay
# can automatically recover its Solum session after a restart or refresh-token
# expiry. The password stays in Railway Variables and is never written to disk.
ESL_USERNAME=your-aims-username
ESL_PASSWORD=your-aims-password

# Persistent directory. Mount a Railway Volume here so tokens, mappings and
# analytics survive deployments (for example /app/data).
DATA_DIR=./data

# Solum API request deadline and token refresh safety window.
ESL_REQUEST_TIMEOUT_MS=20000
TOKEN_REFRESH_BUFFER_SECONDS=300
ARTICLE_LOOKUP_TIMEOUT_MS=30000
ARTICLE_CACHE_TTL_SECONDS=300

# How long a duplicate acknowledgement is suppressed.
ACKNOWLEDGE_TTL_SECONDS=60

# --- Port (Railway sets this automatically) ---
PORT=3000
