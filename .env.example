# -------------------------------------------------------
# Copy this file to .env and fill in the values.
# NEVER commit .env to git.
# -------------------------------------------------------

# --- Firebase (from Firebase Console > Project Settings > Service Accounts) ---
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# --- Auth header that AIMS will send ---
# Set AUTH_HEADER_NAME to whatever header name you configure in AIMS
# e.g.  x-auth-key  or  authorization  or  x-api-key
AUTH_HEADER_NAME=x-auth-key
AUTH_KEY=change-me-to-a-strong-secret

# --- AIMS ESL API ---
ESL_BASE_URL=https://eastus.common.solumesl.com/common

# Each associate signs in from their own mobile device. Do not configure a
# shared ESL_USERNAME or ESL_PASSWORD on the relay.

# --- PostgreSQL and encrypted associate token storage ---
DATABASE_URL=postgresql://esl_relay:change-me@localhost:5432/esl_relay
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key

# --- Employee Call Operation dashboard seed user ---
# Used only to seed the first database user; the DB stores a salted hash.
OPS_USERNAME=esladmin
OPS_PASSWORD=replace-with-a-strong-password

# Persistent directory for mappings and durable background jobs.
DATA_DIR=./data

# Solum API request deadline and token refresh safety window.
ESL_REQUEST_TIMEOUT_MS=20000
TOKEN_REFRESH_BUFFER_SECONDS=300
ARTICLE_LOOKUP_TIMEOUT_MS=30000
ARTICLE_CACHE_TTL_SECONDS=300

# A new call remains available for 60 seconds. Webhook retries stop when that
# call window ends, and other background work also has a fixed retry limit.
CALL_RESPONSE_TIMEOUT_SECONDS=60
WEBHOOK_MAX_ATTEMPTS=3
BACKGROUND_JOB_MAX_ATTEMPTS=8

# --- Port ---
PORT=3000
